# Doxygen 設定ファイル
# 使い方: リポジトリのルートで `doxygen` を実行すると Docs/Doxygen/html/index.html が生成される。

PROJECT_NAME           = "Crane"
PROJECT_BRIEF          = "坊主がクレーン車で除夜の鐘を叩くゲーム 再現プロジェクト"
OUTPUT_DIRECTORY       = Docs/Doxygen
OUTPUT_LANGUAGE        = Japanese
INPUT_ENCODING         = UTF-8

INPUT                  = README.md Assets/_Game/Scripts Assets/_Game/Tests
FILE_PATTERNS          = *.cs *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_LOGFILE           = Docs/Doxygen/warnings.log

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
